<!-- WiX v6 source for the BlackMiro Windows installer (.msi).
     Built by scripts\build-installers.bat:
       wix build -arch x64 -d AppVer=1.0.0 -d SrcDir=<deploy folder> -o <out.msi> BlackMiro.wxs -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BlackMiro"
           Manufacturer="BlackMiro"
           Version="$(AppVer)"
           UpgradeCode="5E0C9A3B-6F2D-4C8E-A1B7-3D9F0E2C4A61"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of BlackMiro is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="BlackMiroIcon" />
    <Icon Id="BlackMiroIcon" SourceFile="$(SrcDir)\BlackMiro.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BlackMiro">
        <Component Id="MainExecutable">
          <File Id="BlackMiroExe" Source="$(SrcDir)\BlackMiro.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="BlackMiro"
                      WorkingDirectory="INSTALLFOLDER" Icon="BlackMiroIcon" />
          </File>
        </Component>
        <!-- Everything windeployqt put next to the exe (Qt DLLs, plugins, QML modules, VC runtime). -->
        <Files Include="$(SrcDir)\**">
          <Exclude Files="$(SrcDir)\BlackMiro.exe" />
        </Files>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
  </Package>
</Wix>
